package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

cc_defaults {
    name: "hwcryptohallib_defaults",
    enabled: false,
    shared_libs: [
        "libbase",
        "liblog",
        "libbinder",
        "libbinder_ndk",
        "libbinder_trusty",
        "libtrusty",
        "libutils",
    ],
    cflags: [
        "-Wall",
        "-Werror",
    ],
    proprietary: true,
    arch: {
        arm64: {
            enabled: true,
        },
    },
}

cc_library {
    name: "hwcryptohallib",
    defaults: [
        "hwcryptohallib_defaults",
    ],
    shared_libs: [
        // AIDL interface deps versions, please refer to below link
        // https://source.android.com/docs/core/architecture/aidl/stable-aidl#module-naming-rules
        "android.hardware.security.see.hwcrypto-V1-ndk",
        "android.hardware.security.see.hwcrypto-V1-cpp",
    ],
    srcs: ["hwcryptolib.cpp"],
}

cc_library {
    name: "hwcryptohasharedsecretllib",
    defaults: [
        "hwcryptohallib_defaults",
    ],
    shared_libs: [
        // AIDL interface deps versions, please refer to below link
        // https://source.android.com/docs/core/architecture/aidl/stable-aidl#module-naming-rules
        "android.hardware.security.sharedsecret-V1-ndk",
        "android.hardware.security.sharedsecret-V1-cpp",
    ],
    srcs: ["hwcryptosharedsecretlib.cpp"],
}

cc_library {
    name: "hwcryptohaldelegatorhelperslib",
    defaults: [
        "hwcryptohallib_defaults",
    ],
    srcs: ["delegatorhelpers.cpp"],
}

cc_defaults {
    name: "android.hardware.trusty.hwcryptohal-service_defaults",
    shared_libs: [
        "hwcryptohallib",
        // AIDL interface deps versions, please refer to below link
        // https://source.android.com/docs/core/architecture/aidl/stable-aidl#module-naming-rules
        "android.hardware.security.see.hwcrypto-V1-ndk",
        "android.hardware.security.see.hwcrypto-V1-cpp",
    ],
    vintf_fragments: ["android.hardware.security.see.hwcrypto-service.trusty.xml"],
}

cc_binary {
    name: "android.hardware.trusty.hwcryptohal-service",
    defaults: [
        "hwcryptohallib_defaults",
        "android.hardware.trusty.hwcryptohal-service_defaults",
    ],
    relative_install_path: "hw",
    srcs: [
        "hwcrypto_delegator.cpp",
    ],
    static_libs: [
        "hwcryptohaldelegatorhelperslib",
    ],
    shared_libs: select((soong_config_variable("trusty_system_vm", "enabled"), soong_config_variable("trusty_system_vm", "placeholder_trusted_hal")), {
        (true, false): [
            "hwcryptohasharedsecretllib",
            // AIDL interface deps versions, please refer to below link
            // https://source.android.com/docs/core/architecture/aidl/stable-aidl#module-naming-rules
            "android.hardware.security.sharedsecret-V1-ndk",
            "android.hardware.security.sharedsecret-V1-cpp",
        ],
        (default, default): [],
    }),
    cflags: select((soong_config_variable("trusty_system_vm", "enabled"), soong_config_variable("trusty_system_vm", "placeholder_trusted_hal")), {
        (true, false): ["-DENABLE_SHARED_SECRET_HAL"],
        (default, default): [],
    }),
    vintf_fragments: select((soong_config_variable("trusty_system_vm", "enabled"), soong_config_variable("trusty_system_vm", "placeholder_trusted_hal")), {
        (true, false): ["android.hardware.security.see.hwcrypto.sharedsecret-service.trusty.xml"],
        (default, default): [],
    }),
    init_rc: ["android.hardware.security.see.hwcrypto-service.trusty.rc"],
}

cc_fuzz {
    name: "android.hardware.trusty.hwcryptohal-service_fuzzer",
    enabled: false,
    defaults: ["service_fuzzer_defaults"],
    static_libs: [
        "android.hardware.security.see.hwcrypto-V1-ndk",
        "android.hardware.security.see.hwcrypto-V1-cpp",
        "liblog",
        "hwcryptohallib",
    ],
    shared_libs: [
        "libbinder_trusty",
        "libtrusty",
    ],
    srcs: ["fuzzer.cpp"],
    fuzz_config: {
        cc: [
            "oarbildo@google.com",
        ],
    },
    arch: {
        arm64: {
            enabled: true,
        },
    },
}

cc_test {
    name: "HwCryptoHalDelegatorTests",
    enabled: false,
    require_root: true,
    srcs: [
        "delegatorTest.cpp",
    ],
    cflags: [
        "-Wall",
        "-Werror",
        "-Wextra",
    ],

    shared_libs: [
        "libbase",
        "liblog",
        "libutils",
        "libbinder",
        "libbinder_ndk",
    ],
    static_libs: [
        "android.hardware.security.see.hwcrypto-V1-ndk",
        "android.hardware.security.see.hwcrypto-V1-cpp",
        "hwcryptohallib",
    ],

    arch: {
        arm64: {
            enabled: true,
        },
    },
}
