package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

aidl_interface {
    name: "android.hardware.security.timestamp",
    vendor_available: true,
    host_supported: true,
    srcs: [
        "android/hardware/security/timestamp/ITimeStamper.aidl",
        "android/hardware/security/timestamp/TimeStampReq.aidl",
    ],
    stability: "vintf",
    backend: {
        cpp: {
            enabled: true,
        },
        java: {
            enabled: true,
        },
        ndk: {
            enabled: true,
        },
        rust: {
            enabled: true,
        },
    },
    frozen: false,
}
