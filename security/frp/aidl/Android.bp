package {
    default_team: "trendy_team_android_hardware_backed_security",
    default_applicable_licenses: ["Android-Apache-2.0"],
}

aidl_interface {
    name: "android.hardware.security.factory_reset_protection",
    vendor_available: true,
    srcs: ["android/hardware/security/factory_reset_protection/*.aidl"],
    stability: "vintf",
    backend: {
        java: {
            enabled: true,
            platform_apis: true,
        },
        rust: {
            enabled: true,
        },
    },
    frozen: false,
}

// A rust_defaults that includes the latest FRP AIDL library.  Modules that depend on FRP
// directly can include this rust_defaults to avoid managing dependency versions explicitly.
rust_defaults {
    name: "frp_use_latest_hal_aidl_rust",
    rustlibs: [
        "android.hardware.security.factory_reset_protection-V1-rust",
    ],
}

// A java_defaults that includes the latest FRP AIDL library.  Modules that depend on FRP
// directly can include this rust_defaults to avoid managing dependency versions explicitly.
rust_defaults {
    name: "java_use_latest_hal_aidl_rust",
    rustlibs: [
        "android.hardware.security.factory_reset_protection-V1-java",
    ],
}
