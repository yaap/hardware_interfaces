package {
    default_team: "trendy_team_android_hardware_backed_security",
    // See: http://go/android-license-faq
    default_applicable_licenses: ["hardware_interfaces_license"],
}

rust_test {
    name: "VtsAidlFactoryResetProtectionTest",
    srcs: ["frp_test.rs"],
    test_suites: [
        "general-tests",
        "vts",
    ],
    defaults: [
        "frp_use_latest_hal_aidl_rust",
        "rdroidtest.defaults",
    ],
    test_config: "AndroidTest.xml",
    rustlibs: [
        "libbinder_rs",
    ],
    require_root: true,
}
