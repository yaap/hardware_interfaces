package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

cc_defaults {
    name: "android.hardware.bluetooth.socket-impl-defaults",
    vendor: true,
    srcs: [
        "BluetoothSocket.cpp",
    ],
    shared_libs: [
        "libbase",
        "libbinder_ndk",
        "libhidlbase",
        "libutils",
        "liblog",
    ],
    export_include_dirs: ["."],
}

cc_library_static {
    name: "android.hardware.bluetooth.socket-V1-impl",
    defaults: ["android.hardware.bluetooth.socket-impl-defaults"],
    shared_libs: [
        "android.hardware.bluetooth.socket-V1-ndk",
    ],
}

cc_library_static {
    name: "android.hardware.bluetooth.socket-V2-impl",
    defaults: ["android.hardware.bluetooth.socket-impl-defaults"],
    shared_libs: [
        "android.hardware.bluetooth.socket-V2-ndk",
    ],
}

cc_fuzz {
    name: "android.hardware.bluetooth.socket-service_fuzzer",
    team: "trendy_team_bluetooth",
    defaults: ["service_fuzzer_defaults"],
    vendor: true,
    srcs: [
        "fuzzer.cpp",
    ],
    shared_libs: [
        "liblog",
    ],
    static_libs: [
        "android.hardware.bluetooth.socket-V1-impl",
        "android.hardware.bluetooth.socket-V1-ndk",
        "android.hardware.contexthub-V4-ndk",
    ],
    fuzz_config: {
        cc: [
            "jaydenk@google.com",
        ],
    },
}
